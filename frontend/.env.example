# TradeShield frontend environment -- copy to frontend/.env.local and edit.
# Next.js inlines NEXT_PUBLIC_* into the browser bundle at build time; anything
# here is public and must never contain secrets.

# Base URL of the Flask REST API (must be reachable from the browser).
# The code default is http://localhost:5001/api, so this file is optional unless
# the backend runs elsewhere.
NEXT_PUBLIC_API_URL=http://localhost:5001/api