{
  "name": "tradeshield-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "scan": "rg -n '[^\\x00-\\x7F]' --type-add 'src:*.{ts,tsx,js,jsx,json,md,mdx,css,scss}' --type src -g '!dist' -g '!build' -g '!.next' -g '!node_modules' || true"
  },
  "dependencies": {
    "next": "^16.3.8-canary.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "typescript": "^5.8.3"
  }
}
