# TradeShield * environment template -- copy to .env and fill in.
# Loaded by db/apply.py, db/verify.py and the Flask backend (all read the repo root).

# --- database (Supabase DSN, used by db/apply.py and Flask) ---------------------
# Use the Session/pooler connection string (port 6543) for serverless deployments
# and the direct connection (port 5432) from a fixed machine. If the password
# contains @ : / ? # or %, percent-encode it (%40, %3A, ...) or the DSN will parse
# the host incorrectly.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# --- backend ---------------------------------------------------------------------
FLASK_PORT=5001

# MUST be a long random string (>= 32 bytes). If it is missing or too short the API
# refuses to use it and generates a throwaway per-process secret, which
# invalidates every session on restart.
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=8

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SAFE DEFAULT -- leave false. When true, the API honours the client-supplied
# X-Origin-IP header *and* the order body's origin_ip field, so you can trigger the
# blocked/flagged screening paths from the browser's "Security context (demo)"
# panel in the order ticket. Enable it only for local demos: with it on, any client
# chooses the address that threat screening is evaluated against.
TRUST_CLIENT_IP_HEADER=false

# --- frontend --------------------------------------------------------------------
# Next.js only reads frontend/.env.local (see frontend/.env.example); this value is
# inlined into the browser bundle at build time. The code default already matches
# NEXT_PUBLIC_API_URL below, so it is only needed to point at another host.
NEXT_PUBLIC_API_URL=http://localhost:5001/api